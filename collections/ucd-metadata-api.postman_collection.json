    "_postman_id": "932eb2b3-a233-4481-a109-432dab04cc37",
    "name": "Dúchas API (National Folklore Collection, UCD) CBÉ Metadata API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Dúchas API exposes published content from the National Folklore Collection (Cnuasach Bhéaloideas Éireann) held at University College Dublin. It returns JSON across four databases: the Main Manuscript Collection (CBÉ), the Schools' Collection (CBÉS), the Photographic Collection (CBÉG) and the Persons Database (CBÉD). This description is derived faithfully from the public Dúchas API developer documentation and data dictionary maintained by the Gaois research group.\n\nContact Support:\n Name: Gaois / Dúchas\n Email: eolas@duchas.ie",
      "type": "text/plain"
    }
