{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dúchas API (National Folklore Collection, UCD) CBÉ CBÉD API",
    "version": "0.5.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "CBÉD",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query the Persons Database (CBÉD)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.duchas.ie/api/v0.5/cbed",
            "params": [
              {
                "name": "Gender",
                "value": "",
                "type": "query"
              },
              {
                "name": "AinmID",
                "value": "",
                "type": "query"
              },
              {
                "name": "ViafID",
                "value": "",
                "type": "query"
              },
              {
                "name": "CountyID",
                "value": "",
                "type": "query"
              },
              {
                "name": "PlaceID",
                "value": "",
                "type": "query"
              },
              {
                "name": "Country",
                "value": "",
                "type": "query",
                "description": "ISO 3166-1 alpha-2 code; UK subdivisions use GB-ENG, GB-NIR, GB-SCT, GB-WLS."
              },
              {
                "name": "GeoNameID",
                "value": "",
                "type": "query"
              },
              {
                "name": "Occupation",
                "value": "",
                "type": "query",
                "description": "Occupation code, e.g. IASC, FEIRM."
              },
              {
                "name": "CreatedBefore",
                "value": "",
                "type": "query"
              },
              {
                "name": "CreatedSince",
                "value": "",
                "type": "query"
              },
              {
                "name": "ModifiedBefore",
                "value": "",
                "type": "query"
              },
              {
                "name": "ModifiedSince",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Query the Persons Database (CBÉD)"
        },
        {
          "info": {
            "name": "Get an individual person",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.duchas.ie/api/v0.5/cbed/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an individual person"
        },
        {
          "info": {
            "name": "Persons Database occupation reference list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.duchas.ie/api/v0.5/cbed/occupations"
          },
          "docs": "Persons Database occupation reference list"
        }
      ]
    }
  ],
  "bundled": true
}