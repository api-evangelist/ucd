{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dúchas API (National Folklore Collection, UCD) CBÉ Metadata API",
    "version": "0.5.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metadata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "General API metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.duchas.ie/api/v0.5/api"
          },
          "docs": "General API metadata"
        }
      ]
    }
  ],
  "bundled": true
}