                "description": "ISO 3166-1 alpha-2 code; UK subdivisions use GB-ENG, GB-NIR, GB-SCT, GB-WLS."
              },
              {
                "name": "GeoNameID",
                "value": "",
                "type": "query"
              },
              {
                "name": "Language",
                "value": "",
                "type": "query",
                "description": "ISO 639-1 language code."
              },
              {
                "name": "DateFrom",
                "value": "",
                "type": "query",
                "description": "Year in YYYY format."
              },
              {
                "name": "DateTo",
                "value": "",
                "type": "query",
                "description": "Year in YYYY format."
              },
              {
                "name": "DateAccuracy",
                "value": "",
                "type": "query"
              },
              {
                "name": "CreatedBefore",
                "value": "",
                "type": "query"
              },
              {
                "name": "CreatedSince",
                "value": "",
                "type": "query"
              },
              {
                "name": "ModifiedBefore",
                "value": "",
                "type": "query"
              },
              {
                "name": "ModifiedSince",
                "value": "",
                "type": "query"
              }
            ]
