              },
              {
                "name": "PageID",
                "value": "",
                "type": "query"
              },
              {
                "name": "PartID",
                "value": "",
                "type": "query"
              },
              {
                "name": "ItemID",
                "value": "",
                "type": "query"
              },
              {
                "name": "CollectorID",
                "value": "",
                "type": "query"
              },
              {
                "name": "InformantID",
                "value": "",
                "type": "query"
              },
              {
                "name": "PersonID",
                "value": "",
                "type": "query"
              },
              {
                "name": "RelevantPersonID",
                "value": "",
                "type": "query"
              },
              {
                "name": "CountyID",
                "value": "",
                "type": "query"
              },
              {
                "name": "PlaceID",
                "value": "",
                "type": "query"
              },
              {
                "name": "Country",
                "value": "",
