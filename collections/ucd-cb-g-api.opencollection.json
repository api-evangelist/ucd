{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dúchas API (National Folklore Collection, UCD) CBÉ CBÉG API",
    "version": "0.5.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "CBÉG",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query the Photographic Collection (CBÉG)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.duchas.ie/api/v0.5/cbeg",
            "params": [
              {
                "name": "Status",
                "value": "",
                "type": "query",
                "description": "Editorial status 0-4 (privileged). Only 4 is publication-ready."
              },
              {
                "name": "Digitized",
                "value": "",
                "type": "query"
              },
              {
                "name": "Copyright",
                "value": "",
                "type": "query"
              },
              {
                "name": "Condition",
                "value": "",
                "type": "query"
              },
              {
                "name": "HandbookTopic",
                "value": "",
                "type": "query"
              },
              {
                "name": "PhotographerID",
                "value": "",
                "type": "query"
              },
              {
                "name": "PersonID",
                "value": "",
                "type": "query"
              },
              {
                "name": "RelevantPersonID",
                "value": "",
                "type": "query"
              },
              {
                "name": "CountyID",
                "value": "",
                "type": "query"
              },
              {
                "name": "PlaceID",
                "value": "",
                "type": "query"
              },
              {
                "name": "Country",
                "value": "",
                "type": "query",
                "description": "ISO 3166-1 alpha-2 code; UK subdivisions use GB-ENG, GB-NIR, GB-SCT, GB-WLS."
              },
              {
                "name": "GeoNameID",
                "value": "",
                "type": "query"
              },
              {
                "name": "DateFrom",
                "value": "",
                "type": "query",
                "description": "Year in YYYY format."
              },
              {
                "name": "DateTo",
                "value": "",
                "type": "query",
                "description": "Year in YYYY format."
              },
              {
                "name": "DateAccuracy",
                "value": "",
                "type": "query"
              },
              {
                "name": "CreatedBefore",
                "value": "",
                "type": "query"
              },
              {
                "name": "CreatedSince",
                "value": "",
                "type": "query"
              },
              {
                "name": "ModifiedBefore",
                "value": "",
                "type": "query"
              },
              {
                "name": "ModifiedSince",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "At least one filter parameter is required."
        },
        {
          "info": {
            "name": "Get an individual photograph",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.duchas.ie/api/v0.5/cbeg/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an individual photograph"
        },
        {
          "info": {
            "name": "Photographic Collection subject heading reference list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.duchas.ie/api/v0.5/cbeg/topics/handbook"
          },
          "docs": "Photographic Collection subject heading reference list"
        }
      ]
    }
  ],
  "bundled": true
}